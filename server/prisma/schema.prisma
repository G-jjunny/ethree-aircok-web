generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

/// 카탈로그 파일 종류 (#44). 이미지/PDF 업로드를 구분한다.
/// - image: png/jpeg/webp/gif 등 이미지 파일
/// - pdf: application/pdf 파일
enum CatalogFileType {
  image
  pdf
}

/// 뉴스 게시물 타입 (#66). BLOG/LINK 이원화 정책.
/// - BLOG: 에디터로 작성한 본문(content)을 가지는 블로그형 게시물.
/// - LINK: 외부 URL(externalUrl)로 연결되는 링크형 게시물. content 불필요.
enum NewsType {
  BLOG
  LINK
}

model AdminUser {
  id             String   @id @default(cuid())
  username       String   @unique
  hashedPassword String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// 뉴스 게시물 (#66 타입 이원화).
///
/// 타입 정책:
/// - type=BLOG(기본값): 에디터로 작성한 본문(content)을 가지는 게시물.
///   content 를 채워 사용한다. externalUrl 은 null 로 두는 것을 권장.
/// - type=LINK: 외부 URL(externalUrl)로 연결되는 링크형 게시물.
///   externalUrl 이 필수이며, content 는 선택(요약 목적 허용 — NOT NULL 제약 없음).
///
/// content null 정책:
/// - content 는 nullable(@db.Text). LINK 타입 신규 생성 시 미전달이면 null 저장.
/// - BLOG 타입도 빈 문자열/null 모두 허용(서비스에서 null coalescing 처리).
model NewsPost {
  id          String    @id @default(cuid())
  title       String
  description String
  /// 게시물 본문. BLOG 타입에서 사용. LINK 타입에서는 nullable.
  content     String?   @db.Text
  date        DateTime
  location    String?
  published   Boolean   @default(false)
  coverImage  String?
  /// 뉴스 타입. 기본값 BLOG.
  type        NewsType  @default(BLOG)
  /// 외부 링크 URL. type=LINK 일 때 필수.
  externalUrl String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, date(sort: Desc)])
}

/// 문의하기(Inquiry) 접수 레코드.
///
/// 동적 폼 빌더 도입 정책 (#33):
/// - 폼 필드 구성은 InquiryField 모델로 관리되며, 실제 제출 답안은 answers(Json)에
///   필드 key → 값(string) 매핑으로 저장된다. 예: { "company": "...", "name": "...", ... }
/// - answers 는 NOT NULL DEFAULT '{}' 이며, 값은 항상 문자열로 정규화되어 저장된다
///   (서비스가 동적 검증 후 String 으로 강제). 정의(InquiryField)에 없는 key 는 저장하지 않는다.
///
/// 기존 고정 컬럼(company/name/phone/email/message) 호환 정책:
/// - 동적 폼 도입 전 데이터 보존을 위해 고정 컬럼은 nullable 로 유지한다(삭제하지 않음).
/// - 신규 접수는 고정 컬럼을 채우지 않고 answers 에만 저장한다(서비스 구현 기준).
///   읽기 측(어드민 목록/메일)은 answers 를 단일 소스로 사용한다.
/// - 마이그레이션 시점에 기존 행의 고정 컬럼 값을 answers JSONB 로 백필했다.
/// - 고정 컬럼은 차후 별도 마이그레이션에서 제거될 수 있다(현재는 호환 목적 잔존).
model Inquiry {
  id        String   @id @default(cuid())
  /// 동적 폼 답안. 필드 key → 문자열 값 매핑. NOT NULL, 기본 {}.
  answers   Json     @default("{}")
  company   String?
  name      String?
  phone     String?
  email     String?
  message   String?  @db.Text
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
}

/// 문의하기 동적 폼 필드 정의 (#33).
///
/// 어드민이 문의하기 폼의 필드 구성을 CRUD 로 관리한다. 공개 폼은
/// GET /api/inquiry/fields 로 이 정의를 받아 동적으로 렌더링하고, 제출 시
/// Inquiry.answers 에 key → 값 매핑으로 저장한다.
///
/// 컬럼 정책:
/// - key: 폼 제출 answers 의 키이자 메일 템플릿 치환 변수(slug). 영소문자/숫자/언더스코어,
///   첫 글자는 영소문자. 유니크. 생성 후 변경 불가(메일 템플릿/기존 answers 와의 정합성 보장).
/// - type: 'text' | 'textarea' | 'email' | 'tel' (옵션형 미지원).
/// - required: 필수 입력 여부. 서비스가 제출 시 동적 검증한다.
/// - order: 폼 내 표시 순서(오름차순). 동률 시 createdAt 보조 정렬 권장.
///
/// 기본 5필드(company/name/phone/email/message)는 마이그레이션 INSERT 로 시드된다.
/// 이들 key 는 메일 템플릿 치환 변수({{company}} 등)와 1:1 일치한다.
model InquiryField {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  type        String
  required    Boolean  @default(true)
  placeholder String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 문의 접수 알림 메일 설정 (싱글톤).
///
/// 운용 방식 (고정 PK 싱글톤):
/// - 이 테이블에는 항상 id = 'singleton' 인 행 1개만 존재한다.
/// - GET /api/inquiry/mail-setting: service 는 upsert({ where: { id: 'singleton' } })
///   로 조회한다. 행이 없으면 기본값으로 lazy 생성 후 반환한다(아래 기본값 참고).
/// - PUT /api/inquiry/mail-setting: upsert 로 id 'singleton' 행을 갱신(없으면 생성)한다.
/// - 고정 PK 상수('singleton')를 사용해 항상 결과 1행을 유지한다.
///
/// lazy 생성 시 기본값:
/// - recipientEmail: env INQUIRY_RECIPIENT_EMAIL 폴백, 없으면 빈 문자열
/// - subjectTemplate: "[스마트에어콕] 새 문의가 접수되었습니다"
/// - bodyTemplate: 기본 본문 템플릿 ({{...}} 치환 변수 포함)
///
/// 템플릿 치환 변수 (subjectTemplate / bodyTemplate 공통):
/// - {{company}} {{name}} {{phone}} {{email}} {{message}}
/// - MailService 가 발송 시 위 토큰을 해당 Inquiry 값으로 치환한다.
model MailSetting {
  id              String   @id @default("singleton")
  recipientEmail  String
  subjectTemplate String   @db.Text
  bodyTemplate    String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// 문의하기 페이지 지도 표시용 주소 설정 (싱글톤).
///
/// 운용 방식 (고정 PK 싱글톤):
/// - 이 테이블에는 항상 id = 'singleton' 인 행 1개만 존재한다.
/// - GET /api/inquiry/map-setting: service 는 upsert({ where: { id: 'singleton' } })
///   로 조회한다. 행이 없으면 기본 주소값으로 lazy 생성 후 반환한다(아래 기본값 참고).
///   이 GET 은 공개 엔드포인트(인증 불필요)로, 문의하기 페이지에서 지도 주소를 노출한다.
/// - PUT /api/inquiry/map-setting: 어드민 전용. upsert 로 id 'singleton' 행을
///   갱신(없으면 생성)한다.
/// - 고정 PK 상수('singleton')를 사용해 항상 결과 1행을 유지한다.
///
/// lazy 생성 시 기본값:
/// - address: "서울특별시 성동구 아차산로17길 49 성수 생각공장 데시앙플렉스 815호"
///   (프론트 SITE 상수를 import 할 수 없으므로 백엔드 상수로 동일 값을 보유한다)
///
/// 컬럼 정책:
/// - 주소 문자열(address) 만 보관한다. 지도 SDK 가 주소 → 좌표 변환을 담당하므로
///   lat/lng 등 좌표 컬럼은 두지 않는다.
model MapSetting {
  id        String   @id @default("singleton")
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// FAQ 카테고리 (예: "제품 관련", "실내공기질").
///
/// 운용 방식:
/// - name 은 유니크. 중복 카테고리명 불가.
/// - order 오름차순으로 공개 목록 노출.
/// - 카테고리 삭제 시 연결된 FaqItem 이 존재하면 서비스 레이어에서 삭제 거부 또는 cascade 처리 결정.
///   (현재 정책: onDelete Restrict — 항목이 있으면 카테고리 삭제 불가)
model FaqCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  items     FaqItem[]
}

/// FAQ 개별 항목.
///
/// 컬럼 정책:
/// - answer 는 줄바꿈/마크다운 포함 가능성으로 @db.Text 지정.
/// - order 는 카테고리 내 표시 순서(오름차순). 동률 시 createdAt 보조 정렬 권장.
/// - categoryId → FaqCategory 외래키. 카테고리 삭제 시 Restrict (카테고리에 항목 있으면 삭제 불가).
model FaqItem {
  id         String      @id @default(cuid())
  categoryId String
  category   FaqCategory @relation(fields: [categoryId], references: [id])
  question   String
  answer     String      @db.Text
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([categoryId, order])
}

/// 스마트에어콕 카탈로그 파일 (이미지/PDF) (#44).
///
/// 운용 방식:
/// - 카탈로그 페이지에 노출되는 제품 카탈로그 이미지/PDF 를 어드민이 CRUD 로 관리한다.
/// - 공개 목록(GET /api/catalog)은 order 오름차순으로 노출한다. 동률 시 createdAt 보조 정렬 권장.
/// - 어드민은 드래그앤드롭으로 순서를 일괄 변경한다(PATCH /api/catalog/reorder).
///
/// 컬럼 정책:
/// - fileUrl: POST /api/catalog/uploads (multipart, 필드명 `file`) 응답으로 받은
///   URL 문자열(예: "/uploads/1781859080294-foo.pdf")을 보관한다. 파일 바이너리 아님.
///   이미지/PDF 공통 URL 컬럼이며, 신규 레코드는 이 컬럼을 사용한다.
/// - fileType: image | pdf. 업로드 응답의 fileType 을 그대로 저장. 기본값 image.
/// - imageUrl: 하위호환/백필 잔재용 nullable 컬럼. 신규 레코드는 null 로 둔다(fileUrl 사용).
/// - order: 표시 순서(오름차순). 기본값 0.
model CatalogImage {
  id        String          @id @default(cuid())
  /// (하위호환) 구버전 이미지 URL. 신규 레코드는 null. 기존 데이터 보존용으로만 유지.
  imageUrl  String?
  /// 업로드된 카탈로그 파일 URL (예: "/uploads/xxx.pdf"). POST /api/catalog/uploads 응답값.
  fileUrl   String?
  /// 파일 종류(image | pdf). 업로드 응답 fileType 값을 저장. 기본값 image.
  fileType  CatalogFileType @default(image)
  /// 표시 순서(오름차순). 기본값 0.
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([order])
}

/// 파트너/고객사 구분 enum (#48).
/// - partner: 파트너사
/// - client: 고객사
enum PartnerType {
  partner
  client
}

/// 사이트 기본 정보 싱글톤 (#48).
///
/// 운용 방식 (고정 PK 싱글톤):
/// - 이 테이블에는 항상 id = 'singleton' 인 행 1개만 존재한다.
/// - GET /api/site-info: service 는 findUnique({ where: { id: 'singleton' } }) 로 조회한다.
///   행이 없으면 기본값으로 lazy 생성 후 반환한다.
/// - PUT /api/site-info: upsert 로 id 'singleton' 행을 갱신(없으면 생성)한다. 관리자 인증 필요.
///
/// 컬럼 정책:
/// - companyName, address, phone, email, bizNo, ceo 는 필수(NOT NULL).
/// - fax, mailOrderNo, legalName, instagram, youtube, linkedin, facebook, kakaoUrl 은 선택(nullable).
/// - legalName: 법인명(상호명과 다를 경우 사용). nullable.
model SiteInfo {
  id           String   @id @default("singleton")
  companyName  String
  legalName    String?
  address      String
  phone        String
  email        String
  bizNo        String
  ceo          String
  fax          String?
  mailOrderNo  String?
  instagram    String?
  youtube      String?
  linkedin     String?
  facebook     String?
  kakaoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// 파트너사/고객사 목록 (#48).
///
/// 운용 방식:
/// - type(PartnerType enum)으로 파트너사(partner)와 고객사(client)를 구분한다.
/// - 공개 목록(GET /api/partners)은 order 오름차순, 동률 시 createdAt 보조 정렬.
/// - 어드민은 드래그앤드롭으로 순서를 일괄 변경한다(PATCH /api/partners/reorder).
/// - 로고 이미지는 POST /api/partners/:id/logo (multipart, 필드명 file) 로 업로드하며,
///   업로드 후 해당 Partner 레코드의 logoUrl 을 갱신한다.
///
/// 컬럼 정책:
/// - id: cuid (String). 기존 모델 패턴 통일.
/// - logoUrl: nullable. 로고 이미지 미설정 파트너 허용.
/// - order: 표시 순서(오름차순). 기본값 0.
model Partner {
  id        String      @id @default(cuid())
  name      String
  logoUrl   String?
  type      PartnerType @default(partner)
  order     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([order])
}

/// 에어콕 소개 페이지 OUR Team 섹션 이미지 (#57).
///
/// 운용 방식:
/// - 팀 항목은 이미지만 보관한다(캡션/이름 없음). 이미지 URL + 표시 순서.
/// - 공개 목록(GET /api/team-images)은 order 오름차순, 동률 시 createdAt 보조 정렬.
/// - 단일 이미지 replace 방식: POST 시 기존 레코드 전체를 삭제 후 새 레코드를 생성한다(고아 레코드 방지).
/// - 이미지는 POST /api/team-images/uploads (multipart, 필드명 file) 로 업로드 후 URL을 받아 레코드 생성.
///
/// 컬럼 정책:
/// - id: cuid (String). 기존 모델 패턴 통일.
/// - imageUrl: 업로드된 이미지 URL (예: "/uploads/xxx.png"). NOT NULL.
/// - order: 표시 순서(오름차순). 기본값 0.
model TeamImage {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// 에어콕 소개 페이지 연혁(타임라인) 항목 (#57).
///
/// 운용 방식:
/// - 연혁 항목은 연도(year) + 월(month) + 이벤트 설명(content)으로 구성된다.
/// - 공개 목록(GET /api/timelines)은 최신순으로 노출한다:
///   year 내림차순 → month 내림차순 → 동률 시 createdAt 내림차순(보조).
///
/// 컬럼 정책:
/// - id: cuid (String).
/// - year: 연도(정수). 검증 범위 2000~2100 (DTO 레벨).
/// - month: 월(정수). 검증 범위 1~12 (DTO 레벨).
/// - content: 연혁 이벤트 설명. 비어있지 않은 문자열. NOT NULL.
model TimelineItem {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year(sort: Desc), month(sort: Desc)])
}

/// 에어콕 소개(About) 페이지 IntroSection 핵심가치(Core Value) 카드 (#93).
///
/// 운용 방식:
/// - 이전에는 프론트 `SITE.about.intro.values` 정적 배열로 하드코딩되어 있던 4개 카드
///   (직원 생산성 향상 / 소유빌딩 가치상승 / 에너지 관리비용 개선 / 공기질 개선)를
///   어드민이 CRUD + 순서변경 가능한 DB 콘텐츠로 전환한 모델이다.
/// - 이미지/로고 없는 단순 텍스트 카드(제목 + 설명)이며, 파일 업로드 엔드포인트는 없다.
/// - 공개 목록(GET /api/core-values)은 order 오름차순, 동률 시 createdAt 오름차순(보조) 정렬로 노출한다.
/// - 어드민은 드래그앤드롭으로 순서를 일괄 변경한다(PATCH /api/core-values/reorder, body { items: [{ id, order }] }).
///   reorder 는 트랜잭션 갱신 후 갱신된 전체 배열을 반환한다(partners 패턴).
///
/// 컬럼 정책:
/// - id: cuid (String). 기존 모델 패턴 통일.
/// - title: 카드 제목(짧은 문구). NOT NULL.
/// - description: 카드 설명 문구. NOT NULL.
/// - order: 표시 순서(오름차순). 기본값 0. order 미지정 생성 시 맨 뒤(마지막 order + 1)에 자동 채번한다.
model CoreValue {
  id          String   @id @default(cuid())
  title       String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

/// 공기질 관리 제품군(서비스) 소개 이미지 (#83).
///
/// 운용 방식:
/// - 가변 이미지 목록이다(추가/삭제/드래그앤드롭 정렬/교체). 캡션/제목 없이 이미지 URL + 표시 순서만 보관한다.
/// - 공개 목록(GET /api/service-images)은 order 오름차순, 동률 시 createdAt 보조 정렬로 노출한다.
/// - 이미지 업로드는 2단계다: POST /api/service-images/uploads (multipart, 필드명 file)로 R2(folder: services)에
///   업로드해 공개 URL을 받은 뒤, POST /api/service-images (body { imageUrl, order? })로 레코드를 생성한다.
/// - 이미지 교체/순서 단건 수정은 PATCH /api/service-images/:id (body { imageUrl?, order? })로 처리한다.
/// - 어드민은 드래그앤드롭으로 순서를 일괄 변경한다(PATCH /api/service-images/reorder, body { items: [{ id, order }] }).
///   reorder 는 트랜잭션 갱신 후 갱신된 전체 배열을 반환한다(partners 패턴).
///
/// 컬럼 정책:
/// - id: cuid (String). 기존 모델 패턴 통일.
/// - imageUrl: R2 업로드 후 받은 공개 이미지 URL. NOT NULL.
/// - order: 표시 순서(오름차순). 기본값 0. order 미지정 생성 시 맨 뒤(마지막 order + 1)에 자동 채번한다.
model ServiceImage {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// 진단 서비스 신청 소개 이미지 (#83).
///
/// 운용 방식:
/// - 가변 이미지 목록이다(추가/삭제/드래그앤드롭 정렬/교체). 캡션/제목 없이 이미지 URL + 표시 순서만 보관한다.
/// - 공개 목록(GET /api/diagnosis-images)은 order 오름차순, 동률 시 createdAt 보조 정렬로 노출한다.
/// - 이미지 업로드는 2단계다: POST /api/diagnosis-images/uploads (multipart, 필드명 file)로 R2(folder: diagnosis)에
///   업로드해 공개 URL을 받은 뒤, POST /api/diagnosis-images (body { imageUrl, order? })로 레코드를 생성한다.
/// - 이미지 교체/순서 단건 수정은 PATCH /api/diagnosis-images/:id (body { imageUrl?, order? })로 처리한다.
/// - 어드민은 드래그앤드롭으로 순서를 일괄 변경한다(PATCH /api/diagnosis-images/reorder, body { items: [{ id, order }] }).
///   reorder 는 트랜잭션 갱신 후 갱신된 전체 배열을 반환한다(partners 패턴).
///
/// 컬럼 정책:
/// - id: cuid (String). 기존 모델 패턴 통일.
/// - imageUrl: R2 업로드 후 받은 공개 이미지 URL. NOT NULL.
/// - order: 표시 순서(오름차순). 기본값 0. order 미지정 생성 시 맨 뒤(마지막 order + 1)에 자동 채번한다.
model DiagnosisImage {
  id        String   @id @default(cuid())
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// 진단 서비스 상담 신청 레코드 (#91).
///
/// 운용 방식:
/// - 공개 폼(POST /api/diagnosis-consultation)으로 이름/전화번호를 접수한다 (인증 불필요).
/// - 어드민(GET /api/diagnosis-consultation)에서 목록 조회, 상태 업데이트(PATCH)를 수행한다.
///
/// status 정책:
/// - NEW: 신규 접수(기본값). 아직 상담이 시작되지 않은 상태.
/// - IN_PROGRESS: 상담 진행 중.
/// - DONE: 상담 완료.
model DiagnosisConsultation {
  id               String    @id @default(cuid())
  name             String
  phone            String
  status           String    @default("NEW")
  consultationDate DateTime?
  consultant       String?
  notes            String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([status, createdAt(sort: Desc)])
}
