# 의존성 / 빌드 산출물 (이미지 내부에서 재설치·재빌드)
node_modules
dist

# 시크릿 — 이미지에 절대 포함 금지 (런타임은 compose env_file/environment 로 주입)
.env
.env.*
!.env.example

# VCS / 로그 / 에디터
.git
.gitignore
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
*.log

# 테스트/커버리지
coverage
test

# 도커 관련 파일 자체
Dockerfile
.dockerignore

# NOTE: public/ 은 정적 에셋(useStaticAssets 대상)이라 의도적으로 포함한다.
