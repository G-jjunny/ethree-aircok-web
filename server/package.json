{
  "name": "aircok-server",
  "version": "1.0.0",
  "description": "Aircok Admin Backend",
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/src/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node --project tsconfig.json prisma/seed.ts",
    "prisma:seed:timeline": "ts-node --project tsconfig.json prisma/seed-timeline.ts",
    "prisma:seed:media": "ts-node --project tsconfig.json prisma/seed-media-images.ts",
    "prisma:seed:core-values": "ts-node --project tsconfig.json prisma/seed-core-values.ts",
    "prisma:seed:air-devices": "ts-node --project tsconfig.json prisma/seed-air-devices.ts",
    "prisma:seed:news": "ts-node --project tsconfig.json prisma/seed-news.ts",
    "prisma:update:news-images": "ts-node --project tsconfig.json prisma/update-news-images.ts",
    "migrate:images-to-r2": "ts-node -r tsconfig-paths/register prisma/migrate-images-to-r2.ts",
    "migrate:catalog-team-to-r2": "ts-node --project tsconfig.json prisma/migrate-catalog-team-to-r2.ts",
    "replace:news-seed-images": "ts-node --project tsconfig.json prisma/replace-news-seed-images.ts",
    "fill:blog-content": "ts-node --project tsconfig.json prisma/fill-blog-content.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/throttler": "^5.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.0.0",
    "nodemailer": "^6.9.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^5.0.0",
    "@types/cookie-parser": "^1.4.6",
    "@types/express": "^4.17.0",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/passport-jwt": "^3.0.0",
    "@types/passport-local": "^1.0.0",
    "@types/pg": "^8.11.0",
    "adm-zip": "^0.5.18",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prisma": "^7.0.0",
    "sharp": "^0.33.5",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
