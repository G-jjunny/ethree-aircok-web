DATABASE_URL="postgresql://user:password@localhost:5432/aircok_admin"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
ADMIN_SEED_PASSWORD="change-me-in-production"

# === 문의 알림 메일(SMTP) 설정 ===
# 아래 SMTP_HOST / MAIL_FROM / INQUIRY_RECIPIENT_EMAIL 가 비어 있으면
# 메일 발송은 건너뜁니다. (문의 접수 자체는 정상 동작합니다.)
SMTP_HOST=""                       # SMTP 서버 호스트 (예: smtp.gmail.com)
SMTP_PORT="587"                    # SMTP 포트 (465=SSL, 587=TLS). 미설정 시 587
SMTP_USER=""                       # SMTP 인증 계정 (없으면 무인증 시도)
SMTP_PASS=""                       # SMTP 인증 비밀번호
MAIL_FROM=""                       # 발신자 주소 (예: "스마트에어콕 <noreply@example.com>")
INQUIRY_RECIPIENT_EMAIL=""         # 문의 알림을 수신할 관리자 이메일

# === Cloudflare R2 이미지 스토리지 ===
CLOUDFLARE_ACCOUNT_ID=""           # Cloudflare 계정 ID
R2_ACCESS_KEY_ID=""                # R2 API 토큰 Access Key ID
R2_SECRET_ACCESS_KEY=""            # R2 API 토큰 Secret Access Key
R2_BUCKET_NAME="aircok-news"       # R2 버킷 이름
R2_PUBLIC_URL=""                   # R2 퍼블릭 접근 URL (예: https://pub-xxxx.r2.dev)
